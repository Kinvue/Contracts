{
  "name": "@kinvue/contracts",
  "version": "1.1.6",
  "description": "Contracts package for gRPC communication in KinVue services network",
  "homepage": "https://github.com/Kinvue/Contracts#readme",
  "bugs": {
    "url": "https://github.com/Kinvue/Contracts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinvue/Contracts.git"
  },
  "license": "ISC",
  "author": "illyaklus",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "proto"
  ],
  "scripts": {
    "build": "tsc",
    "generate": "npm run proto:gen",
    "clean": "rimraf dist src/gen",
    "proto:gen": "shx mkdir -p src/gen && protoc --ts_proto_out=src/gen --ts_proto_opt=nestJs=true,outputServices=grpc-js,useExactTypes=false -I ./proto proto/*.proto",
    "dev": "ts-node src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "protobufjs": "^8.4.2",
    "rimraf": "^6.1.3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.8",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@grpc/grpc-js": "^1.14.4",
    "@nestjs/microservices": "^11.1.24",
    "rxjs": "^7.8.2"
  }
}